// open-on-output to lista preferencji (wygrywa pierwsze podłączone): DP-2 to główny monitor pc, eDP-1 wbudowany ekran laptopa, DP-1 zewnętrzny monitor laptopa
// na laptopie 9 i 10 idą na zewnętrzny, reszta na wbudowany
workspace "1" {
  open-on-output "DP-2"
  open-on-output "eDP-1"
}

