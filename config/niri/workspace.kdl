  open-on-output "DP-2"
  open-on-output "eDP-1"
}

workspace "6" {
  open-on-output "DP-2"
  open-on-output "eDP-1"
}

workspace "7" {
  open-on-output "DP-2"
  open-on-output "eDP-1"
}

workspace "8" {
  open-on-output "DP-2"
  open-on-output "eDP-1"
}

