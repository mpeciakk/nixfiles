layout {
    gaps 8

    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
        off
    }
}

gestures {
    hot-corners {
        off
    }
}

overview {
    consolidated-carousel {
        reveal-zoom 0.48
        assembled-zoom 0.22
    }
}

